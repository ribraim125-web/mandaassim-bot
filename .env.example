# =============================================================================
# MandaAssim Bot — variáveis de ambiente
# Copie para .env e preencha. NÃO commitar o .env real.
# =============================================================================

# ── Core / Infra ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
BOT_PHONE=                       # número do WhatsApp do bot (só dígitos, ex: 5561...)
WEBHOOK_BASE_URL=                # URL pública base para webhooks (ex: https://seu-dominio.com)

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=                    # service_role key (acesso server-side)

# ── IA ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=               # Claude (Haiku 4.5)
OPENROUTER_API_KEY=              # fallback / parsing via OpenRouter

# ── Mercado Pago (pagamentos PIX) ────────────────────────────────────────────
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_KEY=                       # chave do painel src/admin.html
ADMIN_PHONES=                    # telefones admin separados por vírgula

# ── Preços / câmbio (têm default no código) ──────────────────────────────────
PRECO_MENSAL=R$ 29,90
PRECO_PRO=R$ 79,90
USD_TO_BRL=5.50

# ── Links de pagamento / upgrade ─────────────────────────────────────────────
LINK_PARCEIRO=
LINK_PARCEIRO_PRO=
LINK_PRO=
LINK_UPGRADE_ANUAL=
LINK_UPGRADE_PRO=
LINK_UPGRADE_WINGMAN=

# =============================================================================
# FEATURE FLAGS
# Modos suportados: false | test | beta | all
#   false → desligado | test → só o *_TEST_PHONE | beta → ~10% (hash) | all → todos
# Mindset só suporta false | test | all (sem beta).
# =============================================================================

# ── Onboarding / narrativa ───────────────────────────────────────────────────
ONBOARDING_V2=true
NARRATIVE_PROACTIVE=false
PROACTIVE_MESSAGES_ENABLED=false
PROGRESSIVE_DISCLOSURE_ENABLED=false
ENABLE_ACT_01_HOOK_DIAGNOSTICO=false

# ── Camada 1 — Análise de print ──────────────────────────────────────────────
ENABLE_PRINT_ANALYSIS=false
PRINT_ANALYSIS_TEST_PHONE=

# ── Camadas 2/3 — Análise de perfil ──────────────────────────────────────────
ENABLE_PROFILE_ANALYSIS=false
PROFILE_ANALYSIS_TEST_PHONE=
ENABLE_PROFILE_SELF_AUDIT=false
PROFILE_SELF_AUDIT_TEST_PHONE=
ENABLE_PROFILE_HER_ANALYSIS=false
PROFILE_HER_ANALYSIS_TEST_PHONE=

# ── Transition Coach ─────────────────────────────────────────────────────────
ENABLE_TRANSITION_COACH=false
TRANSITION_COACH_TEST_PHONE=

# ── Camada 4 — Pré-Date Coach (migration 007 já rodada) ──────────────────────
ENABLE_PREDATE_COACH=false
PREDATE_COACH_TEST_PHONE=

# ── Camada 5 — Debrief Pós-Date (requer migration 008 no Supabase) ───────────
ENABLE_POSTDATE_DEBRIEF=false
POSTDATE_DEBRIEF_TEST_PHONE=

# ── Camada 6 — Cápsulas de Mindset (requer migration 009; só Pro) ────────────
ENABLE_MINDSET_CAPSULES=false
MINDSET_CAPSULES_TEST_PHONE=
